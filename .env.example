# INKVERSE Environment Variables Configuration
# Copy to .dev.vars for local Wrangler development

# Environment Mode
ENVIRONMENT=development
SITE_URL=http://localhost:5173

# Cloudflare D1 Database Binding is configured via wrangler.toml [[d1_databases]]
# Cloudflare R2 Bucket Binding is configured via wrangler.toml [[r2_buckets]]
# Cloudflare KV Namespace Binding is configured via wrangler.toml [[kv_namespaces]]

# Session Secret (Optional: Fallback token generation uses Web Crypto API)
JWT_SECRET=super_secret_inkverse_crypto_token_key_32bytes_min

# Google OAuth Credentials (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: https://blog.shreeharsha.online/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth Credentials (https://github.com/settings/developers)
# Authorization callback URL: https://blog.shreeharsha.online/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Cloudflare Turnstile CAPTCHA (Optional bot prevention)
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
